# Configuration for the tours service.
#
# Copy to .env for local development. .env is git-ignored; only this file is versioned
# (hard rule 6). Real environment variables always win over this file, which is how
# compose and Dokploy override it without editing anything.

# --- Identity ---------------------------------------------------------------
# Name reported in logs, metrics and traces. Required.
SERVICE_NAME=tours

# local | staging | production | test. Gates gRPC reflection and console logging.
ENVIRONMENT=local

# --- Logging ----------------------------------------------------------------
# trace | debug | info | warn | error | fatal | panic
LOG_LEVEL=debug

# --- Transports -------------------------------------------------------------
# gRPC port. The REST gateway reaches it over loopback.
GRPC_PORT=9090

# Port serving /v1/*, /livez, /readyz and /metrics.
HTTP_PORT=8080

# Largest gRPC request accepted, in bytes. Default 4 MiB.
GRPC_MAX_RECV_MSG_SIZE=4194304

# Deadline applied to inbound calls that arrive without one (hard rule 7).
REQUEST_TIMEOUT=30s

# Graceful shutdown budget before the server is forced down.
SHUTDOWN_TIMEOUT=15s

# --- API contract -----------------------------------------------------------
# Oldest client contract version accepted. Below it, calls are rejected with
# CLIENT_TOO_OLD (RF-2c). Empty disables the check.
MIN_CLIENT_API_VERSION=

# --- Observability ----------------------------------------------------------
# OTLP collector address. Empty disables tracing, which is what a bare `go run` wants.
OTLP_ENDPOINT=

# Fraction of traces sampled, 0 to 1. Lower it in production.
TRACE_SAMPLE_RATIO=1.0

# --- Database ---------------------------------------------------------------
# One database per service, no cross-access (hard rule 2). Required.
DATABASE_URL=postgres://dizen:dizen@localhost:5433/tours_db?sslmode=disable

# Connection pool.
DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=30m
DATABASE_MAX_CONN_IDLE_TIME=5m
DATABASE_HEALTH_CHECK_PERIOD=1m
DATABASE_CONNECT_TIMEOUT=5s

# Startup retry. The service retries with backoff instead of crash-looping when its
# database is not up yet, and stays out of /readyz until it answers.
DATABASE_MAX_RETRIES=10
DATABASE_INITIAL_BACKOFF=500ms
DATABASE_MAX_BACKOFF=30s

# Apply pending migrations at startup. True in the container, false when running locally
# against a database somebody else migrates.
DATABASE_RUN_MIGRATIONS=true

# --- Cache (Redis) ----------------------------------------------------------
# Shared across services; keys are namespaced by service name so they cannot collide.
REDIS_URL=redis://localhost:6379/0
REDIS_NAMESPACE=tours
REDIS_DEFAULT_TTL=5m
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_POOL_SIZE=10

# --- Messaging (RabbitMQ) ---------------------------------------------------
AMQP_URL=amqp://dizen:dizen@localhost:5672/

# Topic exchange every domain event is published to.
AMQP_EXCHANGE=dizen.events

# Unacknowledged messages a consumer holds at once. Bounds how much work is redelivered
# when a consumer dies mid-batch.
AMQP_PREFETCH=10

# Delivery attempts before the message goes to <queue>.dlq.
AMQP_MAX_ATTEMPTS=5
AMQP_INITIAL_BACKOFF=1s
AMQP_MAX_BACKOFF=1m
AMQP_PUBLISH_TIMEOUT=5s
AMQP_RECONNECT_DELAY=5s

# --- Outbox -----------------------------------------------------------------
# How often the table is polled when it was empty. This is the floor on how long an event
# waits before being published; a draining backlog does not wait.
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100
OUTBOX_INITIAL_BACKOFF=5s
OUTBOX_MAX_BACKOFF=5m

# --- JWT (EdDSA / Ed25519) --------------------------------------------------
JWT_ISSUER=dizen
JWT_AUDIENCE=dizen-app
JWT_ACCESS_TOKEN_TTL=15m

# Clock drift tolerated when checking exp and iat.
JWT_CLOCK_SKEW=30s

# This service only validates tokens, so it holds no private key: it cannot mint one.
# Leave JWT_PRIVATE_KEY_PEM unset.
# JWT_PRIVATE_KEY_PEM is deliberately absent.

# Verification keys, PKIX PEM, concatenated. During a rotation the retired public key
# stays here until every token it signed has expired.
JWT_PUBLIC_KEYS_PEM=
