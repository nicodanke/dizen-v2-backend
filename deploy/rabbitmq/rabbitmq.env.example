# Variables of the RabbitMQ stack (PRD-18 RF-8, D-32, D-33).
#
# One Dokploy project per environment, each with its own values, which come from the same
# Doppler config as the services that use the broker.

# staging | production. It names the compose project, the container and the node, and the
# container name is the host the services connect to. Required.
DIZEN_ENV=staging

RABBITMQ_USER=dizen

# CAREFUL WHEN CHANGING THE PASSWORD BELOW. RabbitMQ applies RABBITMQ_DEFAULT_USER and
# RABBITMQ_DEFAULT_PASS only on the FIRST boot, while its database is empty. Change the
# variable and redeploy over the existing volume and the broker keeps the old password,
# silently: the log then says `user 'dizen' - invalid credentials`, which reads like a wrong
# value in the application rather than like a variable the broker never read.
#
# Two ways out, and they end in the same place as long as both sides carry the same value:
#
#   docker exec dizen-v2-rabbitmq-<env> rabbitmqctl change_password dizen '<value>'
#   docker compose -p dizen-v2-rabbitmq-<env> down -v     then redeploy on an empty volume
#
# Nothing is lost by resetting the volume: the exchange, the queues, the dead letter queues
# and the bindings are declared by the services at startup.

# SECRET, required. One per environment, never reused. It is half of the AMQP_URL the
# services receive.
# Generate it with `openssl rand -hex 32`, NOT with `-base64`: this value ends up inside a
# URL, and base64 produces `+`, `/` and `=`. A `/` or an `@` in the credentials section of
# amqp:// or redis:// truncates the parse, and the client ends up sending credentials that
# are not the ones you set -- which surfaces as an authentication error, not a syntax one.
RABBITMQ_PASSWORD=

# Port on the host's loopback for the management UI, reachable through an SSH tunnel. AMQP
# itself is not published at all.
#
# It has to differ per environment when both run on the same VPS. Two containers cannot
# bind the same port, and the second one fails to start with `address already in use`.
#   staging:      15672 (the default)
#   production:   15673
RABBITMQ_UI_PORT=15672

# --- What the services need to be given -------------------------------------
# Once this is up, the AMQP_URL in the application project points here by container name:
#
#   staging:      amqp://dizen:<password>@dizen-v2-rabbitmq-staging:5672/
#   production:   amqp://dizen:<password>@dizen-v2-rabbitmq-production:5672/
#
# There is nothing else to configure: the exchange, the queues, the dead letter queues and
# the bindings are declared by the services at startup (01 section 4.3).
