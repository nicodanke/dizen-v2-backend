# Variables of the RabbitMQ stack (PRD-18 RF-8, D-32, D-33).
#
# One Dokploy project per environment, each with its own values, which come from the same
# Doppler config as the services that use the broker.

# staging | production. It names the compose project, the container and the node, and the
# container name is the host the services connect to. Required.
DIZEN_ENV=

RABBITMQ_USER=dizen

# SECRET, required. Generate with `openssl rand -base64 32`, one per environment, never
# reused. It is half of the AMQP_URL the services receive.
RABBITMQ_PASSWORD=

# --- What the services need to be given -------------------------------------
# Once this is up, the AMQP_URL in the application project points here by container name:
#
#   staging:      amqp://dizen:<password>@dizen-v2-rabbitmq-staging:5672/
#   production:   amqp://dizen:<password>@dizen-v2-rabbitmq-production:5672/
#
# There is nothing else to configure: the exchange, the queues, the dead letter queues and
# the bindings are declared by the services at startup (01 section 4.3).
