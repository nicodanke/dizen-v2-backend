# Variables of the Redis stack (PRD-18 RF-8, D-32, D-33).
#
# One Dokploy project per environment, each with its own values, which come from the same
# Doppler config as the services that use it.

# staging | production. It names the compose project and the container, and the container
# name is the host the services connect to. Required.
DIZEN_ENV=staging

# SECRET, required. One per environment, never reused. It is half of the REDIS_URL the
# services receive.
# Generate it with `openssl rand -hex 32`, NOT with `-base64`: this value ends up inside a
# URL, and base64 produces `+`, `/` and `=`. A `/` or an `@` in the credentials section of
# amqp:// or redis:// truncates the parse, and the client ends up sending credentials that
# are not the ones you set -- which surfaces as an authentication error, not a syntax one.
REDIS_PASSWORD=

# Ceiling inside Redis, which must stay below the container limit of 256M. With
# `noeviction` -- see the compose file for why -- reaching it fails writes loudly instead of
# dropping keys that must not be dropped.
REDIS_MAXMEMORY=192mb

# --- What the services need to be given -------------------------------------
# Once this is up, the REDIS_URL in the application project points here by container name:
#
#   staging:      redis://:<password>@dizen-v2-redis-staging:6379/0
#   production:   redis://:<password>@dizen-v2-redis-production:6379/0
#
# The five services share it; REDIS_NAMESPACE keeps their keys apart.
