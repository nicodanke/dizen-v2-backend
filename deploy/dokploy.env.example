# Variables of the production and staging deployment (PRD-18 RF-3, RF-8).
#
# This file is the inventory, not the values: every variable named, none filled in. The
# values live in Doppler and reach Dokploy through its Doppler secrets provider (D-33), so
# there is no .env on the server and no secret in this repository (hard rule 6).
#
# ---------------------------------------------------------------------------
# How this is wired
# ---------------------------------------------------------------------------
#
#   Doppler project `dizen-v2-backend`
#     ├── config `stg`  ->  Dokploy provider `doppler-stg`  ->  project dizen-v2-staging
#     └── config `prd`  ->  Dokploy provider `doppler-prd`  ->  project dizen-v2-production
#
# One Doppler config per environment and one Dokploy provider per config, which is what keeps
# RF-2 true: nothing shared between staging and production, including the token that reads
# the secrets.
#
# 1. In Doppler, open the config and generate a **Service Token** in the Access tab. It is
#    read-only and scoped to that one project and config, so a leaked token exposes that
#    config and nothing else. Personal and CLI tokens also work and are worse.
# 2. In Dokploy, Settings -> Secrets -> Add Provider -> Doppler. Name it `doppler-stg` or
#    `doppler-prd`, paste the token, test the connection, and assign it to the environment.
# 3. In the environment variables of the Dokploy project, reference each secret:
#
#       IDENTITY_DATABASE_URL=${{vault.doppler-stg.IDENTITY_DATABASE_URL}}
#
#    The non-secret variables below are written literally; only the ones marked SECRET need
#    to go through the vault.
#
# Locally there is no .env either: `make up` runs the compose under `doppler run` when the
# CLI is configured, and falls back to the committed defaults when it is not.

# --- Environment ------------------------------------------------------------
# staging | production. It names the compose project and prefixes every Traefik router, so
# the two environments -- and the v1 stack that shares this Traefik -- cannot collide.
# Required.
DIZEN_ENV=

# trace | debug | info | warn | error. `info` in production, `debug` in staging.
LOG_LEVEL=info

# --- Build ------------------------------------------------------------------
# Baked into the binary and reported by /livez and by the logs. When absent the build says
# "dev", which is honest.
VERSION=
COMMIT=
BUILD_DATE=

# --- Domains (RF-5) ---------------------------------------------------------
# v2 runs alongside the v1 stack, which already owns api.dizen.pro and grpc-*.dizen.pro, so
# v2 lives under its own subdomain until v1 is retired (D-31):
#
#   staging      api.staging.v2.dizen.pro   grpc.staging.v2.dizen.pro   admin-api.staging.v2.dizen.pro
#   production   api.v2.dizen.pro           grpc.v2.dizen.pro           admin-api.v2.dizen.pro
#
# The cutover, when it comes, is a DNS and host-rule change and nothing else.

# Public REST gateway, path-routed to identity, tours and booking. Required.
API_HOST=

# gRPC for the mobile app, HTTP/2 end to end (RF-6). Required.
GRPC_HOST=

# API of the dashboard, the `admin` service. Required.
# The dashboard itself is static and deploys from dizen-v2-web.
ADMIN_API_HOST=

# Certificate resolver configured in the Traefik of Dokploy. The v1 stack uses `letsencrypt`.
CERT_RESOLVER=letsencrypt

# --- Edge protection --------------------------------------------------------
# RF-5: staging carries an extra basic authentication over the REST hosts. Set it to
# ",<env>-v2-basicauth@docker" in staging -- the leading comma is part of the value, since it
# is appended to the middleware chain -- and leave it EMPTY in production.
#
#   staging:      EXTRA_MIDDLEWARES=,staging-v2-basicauth@docker
#   production:   EXTRA_MIDDLEWARES=
#
# The gRPC hosts are deliberately left out: a gRPC client sends its own Authorization header,
# and basic authentication over it would break the app in staging without adding anything,
# because those calls already need a valid JWT.
EXTRA_MIDDLEWARES=

# htpasswd lines for that middleware, comma separated. Generate with:
#   htpasswd -nbB dizen '<password>'
#
# CAREFUL: a bcrypt hash is full of `$`, and `$` is what Compose interpolates. Every `$` has
# to be doubled, or the hash arrives mutilated and the login simply never works:
#
#   htpasswd output   dizen:$2y$05$P4s...
#   what goes here    dizen:$$2y$$05$$P4s...
#
# SECRET. Only needed in staging.
BASIC_AUTH_USERS=

# --- Data stores (D-32) -----------------------------------------------------
# Postgres, Redis and RabbitMQ are managed outside this compose, the same way the v1 stack
# does it, and arrive as connection strings. One database and one credential per service, no
# cross-access (hard rule 2): a leaked DSN exposes one domain.
#
# All five SECRET and required. Format:
#   postgres://<user>:<password>@<host>:5432/<database>?sslmode=require
#
# tours needs PostGIS (01 section 5); the other four do not.
IDENTITY_DATABASE_URL=
TOURS_DATABASE_URL=
BOOKING_DATABASE_URL=
ADMIN_DATABASE_URL=
MAIL_DATABASE_URL=

# Shared by the five services, with keys namespaced per service. SECRET, required.
#   redis://:<password>@<host>:6379/0
REDIS_URL=

# SECRET, required.
#   amqp://<user>:<password>@<host>:5672/
AMQP_URL=

# Topic exchange every domain event is published to.
AMQP_EXCHANGE=dizen.events

# --- JWT (EdDSA / Ed25519) --------------------------------------------------
JWT_ISSUER=dizen
JWT_AUDIENCE=dizen-app

# SECRET. Only identity receives it: it is the only service that issues tokens, and the only
# one that can. Generate the pair outside the repository; `make jwt-key` produces one for
# development and its key must never reach an environment.
JWT_PRIVATE_KEY_PEM=

# Public verification keys, PKIX PEM, concatenated. Every service gets these. During a
# rotation the retired key stays here until the last token it signed has expired.
JWT_PUBLIC_KEYS_PEM=

# --- API contract -----------------------------------------------------------
# Oldest client contract version accepted; below it the interceptor answers CLIENT_TOO_OLD
# and the app asks the user to update (PRD-00 RF-2c). Empty disables the check.
MIN_CLIENT_API_VERSION=

# --- Observability ----------------------------------------------------------
# OTLP collector. Empty until RF-14 deploys it, which disables exporting rather than
# retrying against an address that answers nothing.
OTLP_ENDPOINT=

# Fraction of traces sampled. 1.0 in staging, a fraction in production.
TRACE_SAMPLE_RATIO=0.1

# --- Backups (RF-9) ---------------------------------------------------------
# Daily dump of the five databases to a bucket OUTSIDE this server, keeping 7 daily, 4 weekly
# and 3 monthly. RPO <= 24 h, RTO <= 2 h (RNF-3). Moving the databases out of this compose
# changed nothing here: the backup only ever needed the DSNs above and the bucket below.

# Bucket that receives them. Required. Use a different one per environment, or at least a
# different prefix: a restore drill must not be able to touch production's copies.
BACKUP_BUCKET=

# Cron expression, in BACKUP_TZ.
BACKUP_SCHEDULE=0 3 * * *
BACKUP_TZ=UTC

# Retention. Never set any of these to 0: the prune step refuses it, because a retention of
# zero deletes every copy on the first run.
BACKUP_RETAIN_DAILY=7
BACKUP_RETAIN_WEEKLY=4
BACKUP_RETAIN_MONTHLY=3

# S3-compatible destination. Cloudflare R2 is the one in use (D-6); any S3 works, and the
# restore drill runs against a local MinIO with `Minio` as the provider.
#   R2 endpoint: https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto

# SECRET, required. Scope the token to this bucket alone: it is the credential that, if it
# leaked, would hand over a copy of every database.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# --- Authoring: routing and tiles (RF-3b, doc 07) ---------------------------
# Both live in staging only: the dashboard is their only user, and a re-import must not
# compete for CPU with user traffic -- or with the v1 stack on the same VPS.

# Regional OSM extract Valhalla builds its tiles from. Geofabrik publishes them by region:
#   https://download.geofabrik.de/south-america/argentina-latest.osm.pbf
VALHALLA_TILE_URL=

# What `tours` uses to reach it. Internal address, never public. Empty in production.
#   staging:      VALHALLA_URL=http://valhalla:8002
#   production:   VALHALLA_URL=
VALHALLA_URL=

# Area planetiler generates the .pmtiles for, in its own naming (07 section 4.2):
#   PLANETILER_AREA=argentina
PLANETILER_AREA=
