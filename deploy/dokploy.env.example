# Variables of the production and staging deployment (PRD-18 RF-3, RF-8).
#
# This file is the inventory, not the values: it is versioned with every variable named and
# empty, and the real values live only in Dokploy, one set per project (hard rule 6). Copy
# it into the environment tab of `dizen-staging` and of `dizen-production`, and fill in each
# one separately -- RF-2 asks for nothing shared between the two, and that includes every
# password below.
#
# Generate each password with `openssl rand -base64 32`, one per line, never reused between
# environments. `deploy/docker-compose.prod.yml` fails to start if any of the required ones
# is missing, which is the intended behaviour: a database that comes up with an empty
# password is worse than a deployment that does not come up.

# --- Environment ------------------------------------------------------------
# staging | production. It names the compose project and prefixes every Traefik router, so
# the two environments can share one Traefik without overwriting each other. Required.
DIZEN_ENV=

# trace | debug | info | warn | error. `info` in production, `debug` in staging.
LOG_LEVEL=info

# --- Build ------------------------------------------------------------------
# Baked into the binary and reported by /livez and by the logs. Dokploy can fill them in
# from the deployment; when they are absent the build says "dev", which is honest.
VERSION=
COMMIT=
BUILD_DATE=

# --- Domains (RF-5) ---------------------------------------------------------
# Public REST gateway: api.dizen.app, stg-api.dizen.app in staging. Required.
API_HOST=

# gRPC for the mobile app, HTTP/2 end to end (RF-6): grpc.dizen.app. Required.
GRPC_HOST=

# API of the dashboard, the `admin` service: admin-api.dizen.app. Required.
# The dashboard itself (admin.dizen.app) is static and deploys from dizen-v2-web.
ADMIN_API_HOST=

# Certificate resolver configured in the Traefik of Dokploy. Its default is `letsencrypt`.
CERT_RESOLVER=letsencrypt

# --- Edge protection --------------------------------------------------------
# RF-5: staging carries an extra basic authentication over the REST hosts. Set it to
# ",<env>-basicauth@docker" in staging -- the leading comma is part of the value, since it
# is appended to the middleware chain -- and leave it EMPTY in production.
#
#   staging:      EXTRA_MIDDLEWARES=,staging-basicauth@docker
#   production:   EXTRA_MIDDLEWARES=
#
# The gRPC hosts are deliberately left out of the chain: a gRPC client sends its own
# Authorization header and basic authentication over it would break the app in staging
# without adding anything, because those calls already need a valid JWT.
EXTRA_MIDDLEWARES=

# htpasswd lines for that middleware, comma separated. Generate with:
#   htpasswd -nbB dizen '<password>'
#
# CAREFUL: a bcrypt hash is full of `$`, and `$` is what Compose interpolates. Every `$`
# has to be doubled here, or the hash arrives mutilated and the login simply never works:
#
#   htpasswd output   dizen:$2y$05$P4s...
#   what goes here    dizen:$$2y$$05$$P4s...
#
# SECRET. Only needed in staging.
BASIC_AUTH_USERS=

# --- Databases --------------------------------------------------------------
# One password per database: one database per service and no cross-access (hard rule 2)
# also means one credential each, so a leaked one exposes a single domain. All SECRET and
# all required.
IDENTITY_DB_PASSWORD=
TOURS_DB_PASSWORD=
BOOKING_DB_PASSWORD=
ADMIN_DB_PASSWORD=
MAIL_DB_PASSWORD=

# --- Redis ------------------------------------------------------------------
# SECRET, required. Shared by the five services, with keys namespaced per service.
REDIS_PASSWORD=

# --- RabbitMQ ---------------------------------------------------------------
RABBITMQ_USER=dizen
# SECRET, required.
RABBITMQ_PASSWORD=

# --- JWT (EdDSA / Ed25519) --------------------------------------------------
JWT_ISSUER=dizen
JWT_AUDIENCE=dizen-app

# SECRET. Only identity receives it: it is the only service that issues tokens, and the
# only one that can. Generate the pair outside the repository; `make jwt-key` produces one
# for development and its key must never reach an environment.
JWT_PRIVATE_KEY_PEM=

# Public verification keys, PKIX PEM, concatenated. Every service gets these. During a
# rotation the retired key stays here until the last token it signed has expired.
JWT_PUBLIC_KEYS_PEM=

# --- API contract -----------------------------------------------------------
# Oldest client contract version accepted; below it the interceptor answers CLIENT_TOO_OLD
# and the app asks the user to update (PRD-00 RF-2c). Empty disables the check.
MIN_CLIENT_API_VERSION=

# --- Observability ----------------------------------------------------------
# OTLP collector. Empty until RF-14 deploys it, which disables exporting rather than
# retrying against an address that answers nothing.
OTLP_ENDPOINT=

# Fraction of traces sampled. 1.0 in staging, a fraction in production.
TRACE_SAMPLE_RATIO=0.1

# --- Backups (RF-9) ---------------------------------------------------------
# Daily dump of the five databases to a bucket OUTSIDE this server, keeping 7 daily,
# 4 weekly and 3 monthly. RPO <= 24 h, RTO <= 2 h (RNF-3).

# Bucket that receives them. Required. Use a different one per environment, or at least a
# different prefix: a restore drill must not be able to touch production's copies.
BACKUP_BUCKET=

# Cron expression, in BACKUP_TZ. The default is 03:00, which is the quietest hour here.
BACKUP_SCHEDULE=0 3 * * *
BACKUP_TZ=UTC

# Retention. Never set any of these to 0: the prune step refuses it, because a retention of
# zero deletes every copy on the first run.
BACKUP_RETAIN_DAILY=7
BACKUP_RETAIN_WEEKLY=4
BACKUP_RETAIN_MONTHLY=3

# S3-compatible destination. Cloudflare R2 is the one in use (D-6); any S3 works, and the
# restore drill runs against a local MinIO with `Minio` as the provider.
#   R2 endpoint: https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto

# SECRET, required. Scope the token to this bucket alone: it is the credential that, if it
# leaked, would hand over a copy of every database.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# --- Authoring: routing and tiles (RF-3b, doc 07) ---------------------------
# Both live in staging only: the dashboard is their only user, and a re-import must not
# compete for CPU with user traffic.

# Regional OSM extract Valhalla builds its tiles from. Geofabrik publishes them by region:
#   https://download.geofabrik.de/south-america/argentina-latest.osm.pbf
VALHALLA_TILE_URL=

# What `tours` uses to reach it. Internal address, never public. Empty in production.
#   staging:      VALHALLA_URL=http://valhalla:8002
#   production:   VALHALLA_URL=
VALHALLA_URL=

# Area planetiler generates the .pmtiles for, in its own naming (07 section 4.2):
#   PLANETILER_AREA=argentina
PLANETILER_AREA=
